# 웹 화면 로그인 비밀번호 (8자 이상, 길게!)
APP_PASSWORD=change-me-to-a-long-password

# 저장된 SSH 비밀번호/키 암호화 키. 비워두면 data/secret.key 자동 생성.
# 한 번 정하면 바꾸지 마세요 (바꾸면 저장된 비밀번호를 다시 입력해야 함).
SECRET_KEY=

# 웹 포트 (DSM 이 쓰는 5000/5001 과 겹치지 않게)
PORT=8822

# Wake-on-LAN 브로드캐스트 주소 (공유기 대역에 맞게)
WOL_BROADCAST=192.168.0.255

# 로그인 유지 시간(시간)
SESSION_HOURS=12

# 같은 장비의 리버스 프록시(DSM 등 → localhost) 뒤에 둘 때 1
TRUST_PROXY=0

# ── 외부 접속 (웹 게이트웨이) — README "외부에서 접속하기" 참고 ──
# 먼저 내부망에서 로그인해 "보안" → 2단계 인증을 설정하세요. OTP 가 없으면 외부 로그인은 거부됩니다.
PUBLIC_ACCESS=0
# 외부 허용 IP/대역 (비우면 전체). 예: 203.0.113.7,198.51.100.0/24
ALLOW_PUBLIC_IPS=
# 외부 주소 (리버스 프록시). 예: https://ssh.example.synology.me
PUBLIC_ORIGIN=
